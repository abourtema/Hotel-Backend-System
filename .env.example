# Local development only. Copy this file to .env and replace the placeholders.
# .env is gitignored. Do not commit real passwords, signing keys, or client secrets.
#
# Compose refuses to start when POSTGRES_PASSWORD, DATABASE_CONNECTION_STRING,
# or JWT_SECRET_KEY is missing or empty.

# Password for the PostgreSQL role "postgres".
# Used only when the postgres_data volume is created for the first time.
# Keep this identical to the Password value in DATABASE_CONNECTION_STRING.
# Avoid $ and quotes; Compose interpolates $ while reading .env.
POSTGRES_PASSWORD=

# Npgsql connection string for the API container.
# Host must stay "postgres" (the Compose service name, not localhost).
# Username must stay "postgres" to match POSTGRES_USER and the health check.
# Database must stay "hotel_resort_booking" to match POSTGRES_DB.
DATABASE_CONNECTION_STRING=Host=postgres;Port=5432;Database=hotel_resort_booking;Username=postgres;Password=

# OAuth client IDs. Leave empty to leave that provider unconfigured.
# These are client identifiers, not client secrets or Apple private keys.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# HMAC signing key for Jwt:SecretKey. Required. At least 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET_KEY=
